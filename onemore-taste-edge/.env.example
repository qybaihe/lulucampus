# 真实值不要写进仓库。用 EdgeOne CLI 注入到项目环境变量：
#   edgeone makers env set DOUYIN_COOKIE "<Cookie 请求头>"
#   edgeone makers env set AI_GATEWAY_API_KEY "<key>"
#   edgeone makers env set AI_GATEWAY_BASE_URL "https://ai-gateway.edgeone.link/v1"
#   edgeone makers env set AI_GATEWAY_MODEL "@makers/deepseek-v4-flash"
#
# 本地调试可 `edgeone makers env pull`，生成的 .env 已被 gitignore。

DOUYIN_COOKIE=
DOUYIN_COOKIE_B64=
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash
