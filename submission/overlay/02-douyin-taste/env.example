# 真实值不要写入本文件，也不要打进压缩包。
# 部署到 EdgeOne 时用 CLI 注入：
#   edgeone makers env set DOUYIN_COOKIE_B64 "<base64 of Cookie header>"
#   edgeone makers env set AI_GATEWAY_API_KEY "<key>"

DOUYIN_COOKIE=
DOUYIN_COOKIE_B64=
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash
