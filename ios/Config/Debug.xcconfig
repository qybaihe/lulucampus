// Debug builds talk to the production ONE MORE API on the shared HTTPS domain.
// Hermes is real there; phone auth + campus QR both hit the same Postgres.
API_BASE_URL = https:/$()/lulu.classby.cn/onemore/api
WEB_SOCKET_BASE_URL = wss:/$()/lulu.classby.cn/onemore/api
DEV_AUTH_ENABLED = NO
DEV_USER_ID =
ASSOCIATED_DOMAIN = applinks:dev.onemore.example
APS_ENVIRONMENT = development
CODE_SIGN_STYLE = Automatic
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
