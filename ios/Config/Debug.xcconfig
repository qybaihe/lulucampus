// Debug builds talk to the production ONE MORE API on the shared server.
// Hermes is real there; phone auth + campus QR both hit the same Postgres.
API_BASE_URL = http:/$()/42.194.219.172/onemore/api
WEB_SOCKET_BASE_URL = ws:/$()/42.194.219.172/onemore/api
DEV_AUTH_ENABLED = NO
DEV_USER_ID =
ASSOCIATED_DOMAIN = applinks:dev.onemore.example
APS_ENVIRONMENT = development
CODE_SIGN_STYLE = Automatic
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG
