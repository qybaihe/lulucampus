// Production API over HTTPS. ATS still allows the old IP for leftover HTTP builds.
API_BASE_URL = https:/$()/lulu.classby.cn/onemore/api
WEB_SOCKET_BASE_URL = wss:/$()/lulu.classby.cn/onemore/api
DEV_AUTH_ENABLED = NO
DEV_USER_ID =
ASSOCIATED_DOMAIN = applinks:onemore.example
APS_ENVIRONMENT = production
CODE_SIGN_STYLE = Automatic
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) RELEASE
