ONEMORE_ENV=development
ONEMORE_DATABASE_URL=sqlite:///./onemore.db
ONEMORE_REDIS_URL=redis://localhost:6379/0
ONEMORE_DISTRIBUTED_LOCKS_ENABLED=true
ONEMORE_CELERY_BROKER_URL=redis://localhost:6379/1
ONEMORE_CELERY_RESULT_BACKEND=redis://localhost:6379/2
ONEMORE_HERMES_MODE=fake
ONEMORE_SYSU_CLI=/Users/USER/.local/bin/sysu-anything
ONEMORE_VAULT_ROOT=./vaults
ONEMORE_VAULT_MASTER_KEY=
ONEMORE_ADMIN_TOKEN=change-me
ONEMORE_AUTH_SIGNING_KEY=replace-with-at-least-32-random-bytes
ONEMORE_IDENTITY_HASH_KEY=replace-with-a-separate-random-key
ONEMORE_DEV_AUTH_ENABLED=true
ONEMORE_AUTO_CREATE_SCHEMA=true
ONEMORE_CORS_ORIGINS=["http://localhost:3000"]
ONEMORE_COMPETITION_PUBLIC_SNAPSHOT_VERSION=competition-radar-cn-v1.1-2026-08-11
ONEMORE_MEDIA_ROOT=./runtime/media
ONEMORE_MEDIA_MAX_IMAGE_BYTES=10485760

# Douyin interest import (hackathon MVP, no official Open Platform)
ONEMORE_DOUYIN_IMPORT_ENABLED=true
# Public judge landing: POST /demo/taste/douyin/qr (no App login)
ONEMORE_DEMO_TASTE_PUBLIC_ENABLED=true
ONEMORE_DOUYIN_MODE=fake
ONEMORE_DOUYIN_BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
ONEMORE_DOUYIN_BROWSER_HEADLESS=true
ONEMORE_DOUYIN_RUNTIME_ROOT=./runtime/douyin
ONEMORE_DOUYIN_QR_TIMEOUT_SECONDS=180
ONEMORE_DOUYIN_COLLECTION_TIMEOUT_SECONDS=1200
ONEMORE_DOUYIN_MAX_PARALLEL_IMPORTS=2
ONEMORE_DOUYIN_KEEP_RAW_DEBUG=false
# HTTP share-link import (recent likes + collects + posts, no Playwright).
# Production: put the operator Cookie in /opt/onemore/.env (never commit it).
# Prefer B64 of the Cookie request header so dotenv will not split on ; =
ONEMORE_DOUYIN_HTTP_COOKIE_B64=
ONEMORE_DOUYIN_HTTP_COOKIE=
ONEMORE_DOUYIN_HTTP_COOKIE_PATH=./douyin_like_profile/DouK-Downloader/auth/cookies.json
ONEMORE_DOUYIN_HTTP_RECENT_LIKES=30
ONEMORE_DOUYIN_HTTP_RECENT_POSTS=20
ONEMORE_DOUYIN_HTTP_RECENT_COLLECTS=30
ONEMORE_DOUYIN_HTTP_TIMEOUT_SECONDS=25

# Douyin taste-profile AI narrative (OpenCode Go · DeepSeek V4 Flash only).
# Tests set ONEMORE_ENV=test which disables external LLM calls automatically.
ONEMORE_TASTE_LLM_ENABLED=true
ONEMORE_TASTE_LLM_BASE_URL=https://opencode.ai/zen/go/v1
ONEMORE_TASTE_LLM_MODEL=deepseek-v4-flash
ONEMORE_TASTE_LLM_API_KEY=
ONEMORE_TASTE_LLM_TIMEOUT_SECONDS=45

# Hermes Agent sidecar (OpenCode Go · DeepSeek V4 Flash). Falls back to keyword rules.
ONEMORE_HERMES_AGENT_MODE=sidecar
ONEMORE_HERMES_AGENT_URL=http://127.0.0.1:8642
ONEMORE_HERMES_AGENT_TIMEOUT_SECONDS=60
ONEMORE_HERMES_AGENT_MAX_TOOL_ROUNDS=8
ONEMORE_HERMES_AGENT_MODEL=deepseek-v4-flash
ONEMORE_HERMES_AGENT_API_KEY=
ONEMORE_CAMPUS_MCP_URL=http://127.0.0.1:8000/internal/campus-mcp
ONEMORE_CAMPUS_MCP_TOKEN=
ONEMORE_TOOL_SESSION_TTL_SECONDS=600

# Demo cast live driver: u_demo_1–6 act like students (class / intent / join / confirm).
# Must stay false in production.
ONEMORE_CAST_DRIVER_ENABLED=true
