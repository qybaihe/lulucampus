# FastAPI base
# Local backend:
# VITE_API_BASE=http://127.0.0.1:8000
# Shared production server (same DB / Hermes real as iOS):
VITE_API_BASE=http://42.194.219.172/onemore/api
# Or same-origin relative path when the web is served under /onemore/:
# VITE_API_BASE=/onemore/api

# Optional Debug-only bearer (mirrors iOS DEV_AUTH). Never ship in production builds.
# VITE_DEV_AUTH=dev-token
