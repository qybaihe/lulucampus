# FastAPI base
# Default: shared production API + Postgres (same data as iOS / 线上 Web).
VITE_API_BASE=http://42.194.219.172/onemore/api
# Opt-in local backend:
# VITE_API_BASE=http://127.0.0.1:8000
# Same-origin relative path when the web is served under /onemore/:
# VITE_API_BASE=/onemore/api

# Optional Debug-only bearer (mirrors iOS DEV_AUTH). Only sent when API is localhost.
# VITE_DEV_AUTH=dev-token
